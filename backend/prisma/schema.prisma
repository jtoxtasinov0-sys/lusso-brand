// LUSSO BRAND KR — ma'lumotlar bazasi sxemasi
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- MIJOZ ----------------
model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String
  lastName   String?
  username   String?
  phone      String?
  language   String   @default("uz") // uz | ru
  isBlocked  Boolean  @default(false)
  isAdmin    Boolean  @default(false) // botda /admin buyrug'i orqali beriladi
  createdAt  DateTime @default(now())

  addresses Address[]
  orders    Order[]
}

// ---------------- MANZIL (Koreya) ----------------
model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  title     String  @default("Uy")
  zipCode   String? // 우편번호 (ixtiyoriy)
  city      String? // 도 / 시 / 구 (ixtiyoriy)
  street    String // 주소
  detail    String? // 상세주소 (kvartira, qavat)
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------- KATEGORIYA ----------------
model Category {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  nameUz    String
  nameRu    String
  emoji     String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products Product[]
}

// ---------------- MAHSULOT ----------------
model Product {
  id         Int      @id @default(autoincrement())
  nameUz     String
  nameRu     String
  brand      String?
  descUz     String   @default("")
  descRu     String   @default("")
  price      Int // yangi narx (KRW)
  oldPrice   Int? // eski narx (chizilgan holda ko'rsatiladi)
  categoryId Int
  isActive   Boolean  @default(true)
  isNew      Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// O'lcham / hajm + zaxira
model ProductVariant {
  id         Int    @id @default(autoincrement())
  productId  Int
  label      String // "265mm", "50ml", "Qora"
  stock      Int    @default(0)
  extraPrice Int    @default(0)
  sortOrder  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------------- BUYURTMA ----------------
enum OrderStatus {
  PENDING_PAYMENT // to'lov kutilmoqda
  RECEIPT_SENT // chek yuborildi, admin tekshiryapti
  CONFIRMED // to'lov tasdiqlandi
  SHIPPED // jo'natildi (택배)
  DELIVERED // yetkazildi
  CANCELLED // bekor qilindi
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  userId      Int
  items       Json // [{productId, name, variant, price, qty, image}]
  subtotal    Int
  deliveryFee Int         @default(0)
  total       Int
  status      OrderStatus @default(PENDING_PAYMENT)

  customerName String
  phone        String
  zipCode      String?
  city         String?
  street       String
  detail       String?
  comment      String?

  receiptUrl     String? // chek skrinshoti
  trackingNumber String? // 운송장번호
  adminNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------- STORY ----------------
model Story {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  titleUz   String  @default("")
  titleRu   String  @default("")
  link      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// ---------------- RASSILKA ----------------
model Broadcast {
  id         Int      @id @default(autoincrement())
  text       String
  imageUrl   String?
  buttonText String?
  buttonUrl  String?
  sentCount  Int      @default(0)
  failCount  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ---------------- DO'KON SOZLAMALARI ----------------
model Setting {
  id              Int    @id @default(1)
  shopName        String @default("LUSSO BRAND KR")
  deliveryFee     Int    @default(3000)
  freeDeliveryFrom Int   @default(100000)
  bankName        String @default("Shinhan Bank")
  bankAccount     String @default("110-123-456789")
  bankHolder      String @default("LUSSO BRAND")
  supportUsername String @default("lusso_admin")
  webAppUrl       String @default("") // Mini App tunnel manzili (avtomatik)
  adminUrl        String @default("") // Admin panel tunnel manzili (avtomatik)
  aboutUz         String @default("LUSSO BRAND KR — Koreyadagi erkaklar uchun original oyoq kiyim, ko'zoynak va atirlar do'koni.")
  aboutRu         String @default("LUSSO BRAND KR — магазин мужской обуви, очков и парфюма в Корее.")
  isOpen          Boolean @default(true)
}
